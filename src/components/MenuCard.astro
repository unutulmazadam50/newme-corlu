---
import type { MenuItem } from '../data/menu';
import MacroBadge from './MacroBadge.astro';
import WhatsAppButton from './WhatsAppButton.astro';

interface Props {
  item: MenuItem;
}

const { item } = Astro.props;
---

<article class="bg-white rounded-2xl md:rounded-3xl overflow-hidden border border-[#E4E6E2] shadow-card hover:shadow-card-hover transition-all duration-300 flex flex-col group h-full">
  <!-- Image Container -->
  <a href={`/menu/${item.slug}`} class="relative aspect-[4/3] overflow-hidden bg-[#F1F0EC] block">
    <img
      src={item.image}
      alt={item.name}
      loading="lazy"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
    />
    
    <!-- Top Badges -->
    <div class="absolute top-3 left-3 right-3 flex items-center justify-between pointer-events-none">
      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-white/95 text-[#1E4B32] shadow-sm backdrop-blur-sm">
        {item.categoryName}
      </span>
      {item.featured && (
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-[#D5A44C] text-[#172019] shadow-sm">
          ★ Favori
        </span>
      )}
    </div>

    <!-- Quick Macro Overlay on Bottom Image edge -->
    <div class="absolute bottom-2 right-2 bg-black/70 backdrop-blur-md text-white px-2.5 py-1 rounded-lg text-xs font-bold flex items-center gap-1.5">
      <span>🔥 {item.calories} kcal</span>
      <span class="text-white/40">•</span>
      <span class="text-emerald-400 font-semibold">{item.protein}g Protein</span>
    </div>
  </a>

  <!-- Content Body -->
  <div class="p-5 md:p-6 flex flex-col flex-grow justify-between gap-4">
    <div>
      <div class="flex items-start justify-between gap-2 mb-1.5">
        <a href={`/menu/${item.slug}`} class="group-hover:text-[#2E6B48] transition-colors">
          <h3 class="text-lg md:text-xl font-bold text-[#172019] leading-snug line-clamp-1">
            {item.name}
          </h3>
        </a>
        {item.price && (
          <span class="text-base font-extrabold text-[#1E4B32] whitespace-nowrap">
            {item.price} ₺
          </span>
        )}
      </div>

      <p class="text-xs md:text-sm text-[#697069] line-clamp-2 leading-relaxed mb-4">
        {item.description}
      </p>

      <!-- Macro Details Grid -->
      <div class="mb-2">
        <MacroBadge
          calories={item.calories}
          protein={item.protein}
          carbs={item.carbs}
          fat={item.fat}
        />
      </div>
    </div>

    <!-- Actions -->
    <div class="pt-2 border-t border-[#F1F0EC] flex flex-col gap-2">
      <WhatsAppButton
        message={`Merhaba, New Me web sitesinden geliyorum. "${item.name}" hakkında bilgi almak / sipariş vermek istiyorum.`}
        variant="primary"
        size="sm"
        fullWidth
        label="WhatsApp'tan Sipariş Ver"
      />
      <a
        href={`/menu/${item.slug}`}
        class="text-xs font-semibold text-[#697069] hover:text-[#2E6B48] text-center py-1 transition-colors flex items-center justify-center gap-1"
      >
        <span>İçindekiler & Besin Değerlerini İncele</span>
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</article>
