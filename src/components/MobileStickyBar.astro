---
import { business, createWhatsAppUrl } from '../data/business';

const whatsappUrl = createWhatsAppUrl();
---

<div class="sm:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-md border-t border-[#E4E6E2] p-3 shadow-lg flex items-center gap-2">
  <a
    href="/menu"
    class="flex-1 inline-flex items-center justify-center gap-1.5 py-3 px-4 rounded-full bg-[#E7F0E9] text-[#1E4B32] text-sm font-bold active:scale-[0.98] transition-all min-h-[44px]"
  >
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 6h16M4 12h16M4 18h16" />
    </svg>
    <span>Dijital Menü</span>
  </a>

  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="flex-1 inline-flex items-center justify-center gap-1.5 py-3 px-4 rounded-full bg-[#25D366] text-white text-sm font-bold shadow-sm active:scale-[0.98] transition-all min-h-[44px]"
  >
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
