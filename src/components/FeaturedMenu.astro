---
import { getFeaturedItems } from '../data/menu';
import MenuCard from './MenuCard.astro';

const featuredItems = getFeaturedItems().slice(0, 6);
---

<section class="py-16 md:py-24 bg-[#F8F7F3]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-[#FEF7EA] text-[#A36B0B] text-xs font-bold uppercase tracking-wider mb-3">
        ★ En Çok Tercih Edilenler
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-[#172019] tracking-tight">
        New Me Favorileri
      </h2>
      <p class="text-base text-[#697069] mt-3">
        Çorlu'da misafirlerimizin en çok sevdiği, lezzet ve makro dengesi kusursuz imza tabaklarımız.
      </p>
    </div>

    <!-- 6 Featured Items Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {featuredItems.map((item) => (
        <MenuCard item={item} />
      ))}
    </div>

    <!-- Bottom Action to View Full Menu -->
    <div class="mt-12 text-center">
      <a
        href="/menu"
        class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-[#172019] text-white text-sm font-bold shadow-md hover:bg-[#2E6B48] transition-all duration-200"
      >
        <span>Tüm Dijital Menüyü İncele ({featuredItems.length * 3}+ Çeşit)</span>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    </div>

  </div>
</section>
