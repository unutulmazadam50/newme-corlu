---
import { business } from '../data/business';

const instagramPosts = [
  {
    image: 'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=600&q=80',
    title: 'Taze Somon & Kinoa Kasesi',
  },
  {
    image: 'https://images.unsplash.com/photo-1525351484163-7529414344d8?auto=format&fit=crop&w=600&q=80',
    title: 'Ekşi Mayalı Fit Kahvaltı',
  },
  {
    image: 'https://images.unsplash.com/photo-1610970881699-44a5587cabec?auto=format&fit=crop&w=600&q=80',
    title: 'Green Glow Soğuk Sıkım',
  },
  {
    image: 'https://images.unsplash.com/photo-1512621776951-a57141f2eefd?auto=format&fit=crop&w=600&q=80',
    title: 'Renkli & Dengeli Kaseler',
  },
  {
    image: 'https://images.unsplash.com/photo-1567620905732-2d1ec7ab7445?auto=format&fit=crop&w=600&q=80',
    title: 'Protein Pancake',
  },
  {
    image: 'https://images.unsplash.com/photo-1532550907401-a500c9a57435?auto=format&fit=crop&w=600&q=80',
    title: 'Izgara Bonfile & Sebzeler',
  },
];
---

<section class="py-16 bg-[#F8F7F3]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
      <div>
        <span class="text-xs font-bold text-[#2E6B48] uppercase tracking-wider block mb-1">
          Sosyal Topluluk
        </span>
        <h2 class="text-2xl sm:text-3xl font-black text-[#172019]">
          Instagram'da Bizi Keşfet
        </h2>
      </div>

      <a
        href={business.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm font-bold text-[#172019] hover:text-[#2E6B48] transition-colors"
      >
        <span>{business.instagram}</span>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 17l9.2-9.2M17 17V7.8H7.8"/>
        </svg>
      </a>
    </div>

    <!-- Instagram Photo Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4">
      {instagramPosts.map((post) => (
        <a
          href={business.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative aspect-square overflow-hidden rounded-2xl bg-[#E4E6E2] shadow-sm block"
          aria-label={post.title}
        >
          <img
            src={post.image}
            alt={post.title}
            loading="lazy"
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
          />
          <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center text-white">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
            </svg>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
