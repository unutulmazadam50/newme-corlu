---
import { goals } from '../data/goals';
import GoalCard from './GoalCard.astro';
---

<section id="hedefler" class="py-16 md:py-24 bg-[#F8F7F3]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-[#E7F0E9] text-[#1E4B32] text-xs font-bold uppercase tracking-wider mb-3">
        Kişiselleştirilmiş Beslenme
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-[#172019] tracking-tight">
        Hedefin Ne?
      </h2>
      <p class="text-base text-[#697069] mt-3">
        Günlük yaşam tarzına ve hedefine en uygun lezzetleri hızlıca filtrele.
      </p>
    </div>

    <!-- 3 Goal Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {goals.map((goal) => (
        <GoalCard goal={goal} />
      ))}
    </div>

  </div>
</section>
