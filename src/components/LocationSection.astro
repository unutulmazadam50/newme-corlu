---
import { business, createWhatsAppUrl } from '../data/business';
import WhatsAppButton from './WhatsAppButton.astro';

const whatsappOrderUrl = createWhatsAppUrl('Merhaba, New Me Çorlu şubenize gelmek / sipariş vermek istiyorum.');
---

<section class="py-16 md:py-24 bg-white border-t border-[#E4E6E2]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left: Location Info -->
      <div class="lg:col-span-6 flex flex-col gap-6">
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-[#E7F0E9] text-[#1E4B32] text-xs font-bold uppercase tracking-wider w-fit">
          Çorlu / Tekirdağ
        </span>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-[#172019] tracking-tight">
          New Me'ye Ulaş.
        </h2>

        <p class="text-base text-[#697069] leading-relaxed">
          Çorlu'nun merkezinde, ferah atmosferi ve taze lezzetleriyle New Me Wellness Cafe seni bekliyor. İster paket al, ister WhatsApp üzerinden hızlıca siparişini ver.
        </p>

        <!-- Information Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          
          <div class="p-5 rounded-2xl bg-[#F8F7F3] border border-[#E4E6E2]">
            <span class="text-xl">📍</span>
            <h4 class="text-sm font-bold text-[#172019] mt-2">Adres & Konum</h4>
            <p class="text-xs text-[#697069] mt-1 leading-relaxed">
              {business.address}
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-[#F8F7F3] border border-[#E4E6E2]">
            <span class="text-xl">⏰</span>
            <h4 class="text-sm font-bold text-[#172019] mt-2">Çalışma Saatleri</h4>
            <p class="text-xs text-[#697069] mt-1 leading-relaxed">
              Hafta İçi & Cts: 08:30 - 21:00 <br />
              Pazar: 10:00 - 19:00
            </p>
          </div>

        </div>

        <!-- Dominant WhatsApp CTA -->
        <div class="pt-2">
          <WhatsAppButton
            message="Merhaba, New Me Çorlu adres ve menü hakkında bilgi almak istiyorum."
            variant="primary"
            size="lg"
            label="WhatsApp'tan Yaz"
            fullWidth={true}
          />
        </div>
      </div>

      <!-- Right: Map Card & Quick Visual -->
      <div class="lg:col-span-6">
        <div class="p-8 rounded-3xl bg-[#172019] text-white flex flex-col gap-6 shadow-2xl relative overflow-hidden">
          
          <div class="flex items-center justify-between">
            <div>
              <span class="text-xs text-[#D5A44C] font-bold uppercase tracking-wider">Harita & Yol Tarifi</span>
              <h3 class="text-2xl font-black mt-1">Çorlu Wellness Noktası</h3>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-[#2E6B48] flex items-center justify-center text-xl">
              🗺️
            </div>
          </div>

          <div class="relative rounded-2xl overflow-hidden aspect-[16/10] bg-[#2E6B48]/30 border border-white/10 flex items-center justify-center p-6 text-center">
            <!-- Stylized Map Graphic / Mockup -->
            <div class="flex flex-col items-center gap-3">
              <div class="w-14 h-14 rounded-full bg-white text-[#2E6B48] flex items-center justify-center text-2xl shadow-lg animate-pulse">
                📍
              </div>
              <div>
                <p class="font-bold text-white text-base">New Me Wellness Cafe</p>
                <p class="text-xs text-gray-300">Salih Omurtak Caddesi, Çorlu</p>
              </div>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row items-center gap-3">
            <a
              href={business.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto flex-1 inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-white text-[#172019] text-sm font-bold hover:bg-gray-100 transition-colors"
            >
              <span>Google Haritalarda Aç</span>
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 17l9.2-9.2M17 17V7.8H7.8"/>
              </svg>
            </a>

            <a
              href={`tel:${business.whatsapp}`}
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-white/10 text-white text-sm font-bold hover:bg-white/20 transition-colors"
            >
              <span>Telefonla Ara</span>
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
