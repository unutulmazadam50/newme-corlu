---
import WhatsAppButton from './WhatsAppButton.astro';

const drinks = [
  {
    name: 'Green Glow Soğuk Sıkım',
    type: 'Soğuk Sıkım',
    calories: '110 kcal',
    protein: '3g Protein',
    desc: 'Kereviz sapı, yeşil elma, salatalık, taze zencefil ve limon.',
    image: 'https://images.unsplash.com/photo-1610970881699-44a5587cabec?auto=format&fit=crop&w=600&q=80',
    color: 'from-emerald-900/80',
  },
  {
    name: 'Red Berry Antioksidan',
    type: 'Smoothie',
    calories: '160 kcal',
    protein: '5g Protein',
    desc: 'Böğürtlen, çilek, ahududu, chia tohumu ve badem sütü.',
    image: 'https://images.unsplash.com/photo-1553530666-ba11a7da3888?auto=format&fit=crop&w=600&q=80',
    color: 'from-rose-900/80',
  },
  {
    name: 'Peanut Butter Whey Shake',
    type: 'Protein Shake',
    calories: '320 kcal',
    protein: '34g Protein',
    desc: 'İzole çikolatalı whey, doğal fıstık ezmesi, muz ve espresso dokunuşu.',
    image: 'https://images.unsplash.com/photo-1577805947697-89e18249d767?auto=format&fit=crop&w=600&q=80',
    color: 'from-amber-950/80',
  },
];
---

<section class="py-16 md:py-24 bg-[#F8F7F3]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-[#E7F0E9] text-[#1E4B32] text-xs font-bold uppercase tracking-wider mb-3">
        Ferah & Enerjik
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-[#172019] tracking-tight">
        Gününe Ferah Bir Dokunuş.
      </h2>
      <p class="text-base text-[#697069] mt-3">
        Meyve-sebze içerikli soğuk sıkım içecekleri ve yüksek proteinli shake seçeneklerini keşfet.
      </p>
    </div>

    <!-- Drinks Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {drinks.map((drink) => (
        <div class="group relative overflow-hidden rounded-3xl aspect-[4/5] flex flex-col justify-end p-6 sm:p-8 bg-[#172019] border border-[#E4E6E2] shadow-card hover:shadow-card-hover transition-all duration-300">
          <img
            src={drink.image}
            alt={drink.name}
            loading="lazy"
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-80"
          />
          <div class={`absolute inset-0 bg-gradient-to-t ${drink.color} via-black/40 to-transparent`}></div>

          <div class="relative z-10 text-white flex flex-col gap-2">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-white/20 backdrop-blur-md">
                {drink.type}
              </span>
              <span class="text-xs font-extrabold text-[#D5A44C]">
                💪 {drink.protein}
              </span>
            </div>

            <h3 class="text-xl sm:text-2xl font-bold text-white leading-tight group-hover:text-[#D5A44C] transition-colors">
              {drink.name}
            </h3>

            <p class="text-xs text-gray-200 line-clamp-2 leading-relaxed">
              {drink.desc}
            </p>

            <div class="pt-3 border-t border-white/20 flex items-center justify-between">
              <span class="text-xs font-semibold text-gray-300">{drink.calories}</span>
              <a
                href={`https://wa.me/905300000000?text=${encodeURIComponent(`Merhaba, ${drink.name} hakkında bilgi almak / sipariş vermek istiyorum.`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs font-bold text-[#D5A44C] hover:underline"
              >
                <span>WhatsApp'tan İste</span>
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.528 1.838.78 2.791.78h.001c3.182 0 5.769-2.587 5.769-5.768.001-3.18-2.585-5.764-5.77-5.764zm3.376 8.169c-.14.394-.712.728-1.02.775-.28.043-.643.08-1.849-.419-1.542-.638-2.536-2.196-2.613-2.298-.076-.102-.622-.828-.622-1.579 0-.751.394-1.121.534-1.274.14-.153.305-.192.407-.192.102 0 .204.002.293.006.094.004.22-.036.344.263.127.305.432 1.053.47 1.13.038.076.064.165.013.267-.051.102-.076.165-.153.254-.076.089-.161.199-.23.267-.076.076-.156.159-.067.311.089.153.395.652.848 1.056.583.52 1.074.681 1.227.757.153.076.242.064.331-.038.089-.102.382-.444.483-.597.102-.153.204-.127.343-.076.14.051.89.419 1.043.496.153.076.254.115.292.178.038.064.038.369-.102.763zM12 2C6.477 2 2 6.477 2 12c0 1.891.527 3.659 1.442 5.168l-1.442 5.264 5.424-1.423A9.957 9.957 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Category link -->
    <div class="mt-10 text-center">
      <a
        href="/menu?category=detoks-shake"
        class="inline-flex items-center gap-2 text-sm font-bold text-[#2E6B48] hover:text-[#1E4B32] transition-colors"
      >
        <span>Tüm İçecek & Shake Çeşitlerini İncele</span>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    </div>

  </div>
</section>
