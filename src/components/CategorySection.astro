---
import { categories } from '../data/categories';
import CategoryCard from './CategoryCard.astro';
---

<section class="py-16 md:py-24 bg-white border-b border-[#E4E6E2]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
      <div>
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-[#E7F0E9] text-[#1E4B32] text-xs font-bold uppercase tracking-wider mb-3">
          Zengin Çeşitlilik
        </span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-[#172019] tracking-tight">
          Menü Kategorileri
        </h2>
        <p class="text-base text-[#697069] mt-2">
          Günün her anına uygun, taze ve besleyici seçenekler.
        </p>
      </div>

      <a
        href="/menu"
        class="inline-flex items-center gap-2 text-sm font-bold text-[#2E6B48] hover:text-[#1E4B32] transition-colors"
      >
        <span>Tüm Menüyü Görüntüle</span>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <!-- Category Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {categories.slice(0, 4).map((cat) => (
        <CategoryCard category={cat} />
      ))}
    </div>

    <!-- Second row for remaining categories -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mt-6">
      {categories.slice(4).map((cat) => (
        <CategoryCard category={cat} />
      ))}
    </div>

  </div>
</section>
